# Copiar a deploy/standalone/.env EN EL VPS y reemplazar los CHANGE_ME.
# El .env real nunca se commitea (lo cubre el patron .env del .gitignore raiz).
#
# Generar valores aleatorios:  openssl rand -base64 32

POSTGRES_DB=portal_db
POSTGRES_USER=portal_user
POSTGRES_PASSWORD=CHANGE_ME

# 32+ caracteres: HMAC-SHA256 lo exige.
JWT_KEY=CHANGE_ME

MINIO_ROOT_USER=urbanos_minio
MINIO_ROOT_PASSWORD=CHANGE_ME

# Sin protocolo, solo el host. sslip.io resuelve solo a la IP embebida en el
# nombre, asi que no hay que tocar DNS en ningun lado.
STAGING_DOMAIN=51.161.114.45.sslip.io

# Adonde avisa Let's Encrypt si un certificado esta por vencer sin renovarse.
LETSENCRYPT_EMAIL=CHANGE_ME

# Que config de nginx se monta. deploy.sh lo sobreescribe segun la fase del
# arranque; este valor solo importa si levantas compose a mano.
NGINX_CONF=nginx.conf
